# Network Configuration
RPC_URL=https://rpc.orchard.quai.network
CHAIN_ID=15000

# Deployment Accounts (DO NOT COMMIT ACTUAL KEYS)
CYPRUS1_PK=your_private_key_here


# Quai Vault Addresses (deployed contracts - Cyprus1)
# NOTE: After Quai Vault redeployment, update IMPLEMENTATION to the new address
QUAI_VAULT_FACTORY=0x002d1305D597c157bB975967FA2e5337674b0E5F
QUAI_VAULT_IMPLEMENTATION=0x004E539Cf477A5Cb456A56023f083cD91Bc4934e
# MultiSendCallOnly is the batch execution library for DAO proposals.
# Whitelisted in the vault's delegatecallAllowed mapping at initialization.
# Rejects operation=1 (DelegateCall) sub-transactions, preventing vault storage corruption.
MULTISEND_CALL_ONLY=0x002ae8A47C2da497fe569AfCF0486410aA1093E0


# Quai Vault Configuration (for new vault creation)
# DelegateCall is now managed via a per-target whitelist (delegatecallAllowed mapping).
# During vault initialization, MULTISEND_CALL_ONLY is passed as an initialDelegatecallTarget
# so the vault permits DAOShip to execute batch proposals via MultiSendCallOnly.
# No boolean flag is needed — the whitelist is set atomically at deploy time.
VAULT_MIN_EXECUTION_DELAY=0

# Gas Settings
REPORT_GAS=false

# Deployed Contract Addresses (auto-updated via npm run update-env)
DAOSHIP_SINGLETON=
SHARES_SINGLETON=
LOOT_SINGLETON=
DAOSHIP_LAUNCHER=
DAOSHIP_AND_VAULT_LAUNCHER=
POSTER=

# DAO Clone Address (set after creating a DAO via create-dao script)
# Navigators are deployed pointing at a specific DAO clone, not the singleton.
# DAOSHIP_ADDRESS=0x00...

# Navigator Addresses (auto-updated via npm run update-env)
# These are deployed per-DAO, not globally. Each DAO needs its own navigators.
ONBOARDER_NAVIGATOR=
ERC20_TRIBUTE_NAVIGATOR=

# DAO Creation Configuration
#
# Default: Creates a 1/1 vault (single owner = deployer, threshold = 1)
# This allows the deployer to approve the enableModule proposal in a single transaction
#
# Vault Owners (comma-separated addresses, defaults to deployer wallet)
# VAULT_OWNERS=0x007204C0F8eB96e207482e1C472E4f74309aDb86,0x00AnotherAddress...
#
# Vault Threshold (number of required approvals, defaults to 1 for single-owner vault)
# For 1/1 vault: VAULT_THRESHOLD=1 (recommended for initial setup)
# For multisig: VAULT_THRESHOLD=2 or more
# VAULT_THRESHOLD=1

# DAO Members (comma-separated addresses, defaults to deployer if not set)
# Can be different from vault owners - these get the initial shares/loot
# For solo DAO: Leave commented (defaults to deployer with 175 shares)
# For multi-member DAO: Uncomment and configure
# DAO_MEMBERS=0x007204C0F8eB96e207482e1C472E4f74309aDb86,0x00Member2,0x00Member3
# DAO_SHARES=100,50,25
# DAO_LOOT=0,25,10

# DAO Governance Parameters
#
# ╔══════════════════════════════════════════════════════════════════╗
# ║  IMPORTANT: BASIS POINTS vs PERCENTAGE                          ║
# ║                                                                  ║
# ║  DAO Ships uses BASIS POINTS (0–10000) for quorum and retention. ║
# ║  This is intentionally more precise than upstream MolochV3       ║
# ║  which uses raw percentages (0–100).                            ║
# ║                                                                  ║
# ║  CORRECT:   QUORUM_PERCENT=2000   →  20% quorum                 ║
# ║  INCORRECT: QUORUM_PERCENT=20     →  0.2% quorum (100x too low) ║
# ║                                                                  ║
# ║  Always use basis points: multiply your desired % by 100.       ║
# ║    10%  → 1000                                                   ║
# ║    20%  → 2000                                                   ║
# ║    50%  → 5000                                                   ║
# ║    66%  → 6600                                                   ║
# ║   100%  → 10000                                                  ║
# ╚══════════════════════════════════════════════════════════════════╝
#
# PRODUCTION VALUES (default if not set):
# - Voting Period: 7 days (604800 seconds)
# - Grace Period: 3 days (259200 seconds)
# - Proposal Offering: 0.1 QUAI
# - Quorum: 20% (2000 basis points)
# - Sponsor Threshold: 1 share
# - Min Retention: 66% (6600 basis points)
#
# E2E TESTING VALUES (fast proposal lifecycle):
# VOTING_PERIOD=60           # 1 minute
# GRACE_PERIOD=30            # 30 seconds
# PROPOSAL_OFFERING=0.001    # 0.001 QUAI
# QUORUM_PERCENT=2000        # 20% (2000 basis points)
# SPONSOR_THRESHOLD=1        # 1 share
# MIN_RETENTION_PERCENT=6600 # 66% (6600 basis points)
#
# For testing, uncomment and use short periods:
# VOTING_PERIOD=60
# GRACE_PERIOD=30
# PROPOSAL_OFFERING=0.001

# Token Pause Configuration
# If true, the corresponding token will be paused (non-transferable) immediately after DAO launch.
# Useful for DAOs that want to restrict token transfers until governance enables them.
# PAUSE_SHARES_ON_LAUNCH=false
# PAUSE_LOOT_ON_LAUNCH=false
