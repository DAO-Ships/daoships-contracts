# E2E Testing Configuration
# This file is for end-to-end testing ONLY - NOT for production use
# Copy to .env.e2e and fill in actual test wallet keys (NEVER commit actual keys)

# Network Configuration
RPC_URL=https://rpc.orchard.quai.network
CHAIN_ID=15000

# ============================================================================
# TEST WALLET PRIVATE KEYS
# ============================================================================
# Generate test wallets with: npx hardhat run scripts/generate-test-wallets.ts
# OR use Hardhat's built-in test accounts
# IMPORTANT: These should be test wallets with small amounts of testnet QUAI only

# Deployer (DAO creator, initial shares holder)
DEPLOYER_PK=your_test_deployer_private_key_here

# Alice (initial DAO member with shares and loot)
ALICE_PK=your_test_alice_private_key_here

# Bob (will onboard via OnboarderShaman)
BOB_PK=your_test_bob_private_key_here

# Carol (will onboard via EthOnboarderShaman)
CAROL_PK=your_test_carol_private_key_here

# Dave (will check-in via CheckInShaman)
DAVE_PK=your_test_dave_private_key_here

# ============================================================================
# DEPLOYED CONTRACT ADDRESSES (from deployment-addresses.json)
# ============================================================================

# Quai Vault Addresses (deployed contracts - Cyprus1)
QUAI_VAULT_FACTORY=0x005261a837f1eFEa0e23b66dc526EB6054FD2250
QUAI_VAULT_IMPLEMENTATION=0x00707D5c7e35253265267DE764d2625cAb04082C
MULTISEND_LIBRARY=0x0060a725Ef00CB737f24F7e00da94c1Ce03bf1Dc

# DAO Contract Addresses (auto-updated via npm run update-env)
BAAL_SINGLETON=
SHARES_SINGLETON=
LOOT_SINGLETON=
BAAL_SUMMONER=
BAAL_AND_VAULT_SUMMONER=
POSTER=

# Shaman Addresses (if pre-deployed for testing)
ONBOARDER_SHAMAN=
ETH_ONBOARDER_SHAMAN=
CHECKIN_SHAMAN=

# ============================================================================
# E2E TEST DAO CONFIGURATION
# ============================================================================

# Vault Configuration (1/1 for fast testing)
# Single owner (deployer) for quick module enablement
VAULT_OWNERS=0x007204C0F8eB96e207482e1C472E4f74309aDb86
VAULT_THRESHOLD=1

# DAO Members (deployer and alice for initial setup)
# Format: comma-separated addresses
DAO_MEMBERS=0x007204C0F8eB96e207482e1C472E4f74309aDb86,0x00AnotherAddress
DAO_SHARES=100,50
DAO_LOOT=0,25

# ============================================================================
# FAST GOVERNANCE PARAMETERS (E2E Testing)
# ============================================================================
# These are MUCH shorter than production for rapid E2E testing
# DO NOT use these values in production!

# Voting Period: 1 minute (60 seconds)
VOTING_PERIOD=60

# Grace Period: 30 seconds
GRACE_PERIOD=30

# Proposal Offering: 0.001 QUAI (very low for testing)
PROPOSAL_OFFERING=0.001

# Quorum Percentage: 20% (2000 basis points)
QUORUM_PERCENT=2000

# Sponsor Threshold: 1 share (1 QUAI in wei = 1e18)
SPONSOR_THRESHOLD=1

# Minimum Retention: 66% (6600 basis points)
MIN_RETENTION_PERCENT=6600

# ============================================================================
# SHAMAN CONFIGURATION (E2E Testing)
# ============================================================================

# OnboarderShaman (QUAI → shares/loot with multiplier)
ONBOARDER_SHARES_PER_QUAI=20000     # 1 QUAI = 1 share (20000 / 20000)
ONBOARDER_LOOT_PER_QUAI=0           # No loot
ONBOARDER_MIN_TRIBUTE=0.01          # 0.01 QUAI minimum (in QUAI, not wei)
ONBOARDER_EXPIRY=0                  # No expiry for E2E

# QuaiOnboarderShaman (simple QUAI → shares)
# Note: Contract name is "QuaiOnboarderShaman" for Baal ecosystem compatibility
# but it accepts QUAI (native token) on Quai Network
QUAI_ONBOARDER_PRICE_PER_UNIT=0.1   # 0.1 QUAI per share (in QUAI, not wei)
QUAI_ONBOARDER_SHARES_PER_UNIT=1    # 1 share per unit (in QUAI = 1e18 wei)
QUAI_ONBOARDER_SHARES_LOOT=0        # All as shares
QUAI_ONBOARDER_LOOT_LOOT=0          # No loot

# CheckInShamanV2 (periodic rewards)
CHECKIN_INTERVAL=86400              # 24 hours (1 day) in seconds
CHECKIN_REWARD_SHARES=10            # 10 shares per check-in (in QUAI = 10e18 wei)
CHECKIN_REWARD_LOOT=0               # No loot reward
CHECKIN_MAX_MISSED=3                # Max 3 missed check-ins before penalties

# ============================================================================
# GAS & REPORTING
# ============================================================================
REPORT_GAS=true  # Enable gas reporting for E2E tests

# ============================================================================
# USAGE INSTRUCTIONS
# ============================================================================
#
# 1. Copy this file to .env.e2e
# 2. Generate 5 test wallets (or use Hardhat test accounts)
# 3. Fund each wallet with ~1 QUAI on Orchard testnet
# 4. Fill in the private keys above
# 5. Deploy contracts: npm run deploy:orchard
# 6. Update contract addresses (BAAL_SINGLETON, etc.)
# 7. Run E2E tests: npm run test:e2e
#
# ============================================================================
# PRODUCTION VALUES (for reference - DO NOT use for E2E)
# ============================================================================
#
# VOTING_PERIOD=604800               # 7 days
# GRACE_PERIOD=259200                # 3 days
# PROPOSAL_OFFERING=0.1              # 0.1 QUAI
# QUORUM_PERCENT=2000                # 20%
# SPONSOR_THRESHOLD=1                # 1 share
# MIN_RETENTION_PERCENT=6600         # 66%
#
