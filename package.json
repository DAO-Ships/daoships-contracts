{
  "name": "daoships-contracts",
  "version": "1.0.0",
  "description": "DAO Ships — A DAO framework and launchpad for Quai Network, inspired by MolochV3",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test test/unit/*.test.ts test/e2e/local/*.test.ts",
    "test:unit": "hardhat test test/unit/*.test.ts",
    "test:e2e": "hardhat test test/e2e/local/*.test.ts",
    "test:e2e:onchain": "hardhat test test/e2e/onchain/*.test.ts --network cyprus1",
    "test:coverage": "hardhat coverage",
    "test:gas": "REPORT_GAS=true hardhat test test/unit/*.test.ts test/e2e/local/*.test.ts",
    "deploy:poster": "hardhat run scripts/deploy/001_deploy_poster.ts",
    "deploy:singletons": "hardhat run scripts/deploy/002_deploy_singletons.ts",
    "deploy:factories": "hardhat run scripts/deploy/003_deploy_factories.ts",
    "deploy:navigators": "hardhat run scripts/deploy/004_deploy_navigators.ts --network cyprus1",
    "deploy:all": "hardhat run scripts/deploy-all.ts --network cyprus1",
    "create-dao": "hardhat run scripts/create-dao.ts --network cyprus1",
    "update-env": "ts-node scripts/update-env.ts",
    "verify": "hardhat verify",
    "clean": "hardhat clean && rm -rf cache artifacts typechain-types",
    "lint": "solhint 'contracts/**/*.sol'",
    "format": "prettier --write 'contracts/**/*.sol' 'test/**/*.ts' 'scripts/**/*.ts'"
  },
  "keywords": ["dao", "dao-ships", "quai", "governance", "launchpad"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "@quai/hardhat-deploy-metadata": "^1.0.8",
    "dotenv": "^16.4.5",
    "quais": "^1.0.0-alpha.53"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.3",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.6",
    "chai": "^4.3.10",
    "hardhat": "^2.19.5",
    "hardhat-gas-reporter": "^1.0.9",
    "prettier": "^3.1.1",
    "prettier-plugin-solidity": "^1.3.1",
    "solhint": "^4.1.1",
    "solidity-coverage": "^0.8.5",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.3.3"
  }
}
